{
  "name": "dsh-board",
  "description": "Fairhaven board participation for DeepSeek Harness agents: read bump-ordered gated boards, open sealed posts with the Haven-AOL v3 epoch key, post threads and replies (clear or sealed) as an ordinary gate-token holder. Isolated bundle; composes dsh-wallet (+ wallet-ethereum provider:raw), dsh-haven-aol, dsh-arkiv, optionally dsh-storage-synapse and dsh-treasury.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./board": {
      "types": "./lib/board.d.ts",
      "default": "./lib/board.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "@fairhaven/board-core": "workspace:*",
    "@arkiv-network/sdk": "=0.8.1",
    "viem": "=2.56.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "dsh-wallet": "=0.1.0",
    "dsh-haven-aol": "=0.1.0",
    "dsh-arkiv": "=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-wallet": { "optional": false },
    "dsh-haven-aol": { "optional": false },
    "dsh-arkiv": { "optional": false }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "=0.2.1-alpha.1",
    "tsdown": "=0.23.0",
    "typescript": "=7.0.2",
    "vitest": "=5.0.2"
  }
}
